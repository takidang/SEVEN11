@using SevenEleven.Core.Models
@using SevenEleven.Core.Services
@using SevenEleven.Web.Infrastructure
@using SevenEleven.Web.Models.Shop
@model AccountModel
@{
    var c = Model.Customer;
}
<div class="acct-secs">
    <section class="acct-sec">
        <h2 class="sec-title">Các hạng thành viên</h2>
        <p class="sec-sub">Chi tiêu tích luỹ đủ mốc là lên hạng ngay. Mỗi tháng cần chi tối thiểu một mức để giữ hạng.</p>
        <partial name="_TierLadder" model="((MemberTier?)c.Tier, (int?)c.TierSpend)" />
    </section>

    <div class="acct-cols">
        <section class="acct-sec">
            <h2 class="sec-title">Cách tính hạng và sao vàng</h2>
            <partial name="_MembershipRules" model="@("")" />
        </section>

        @* Lịch sử hạng ghi như sổ: ngày ở lề trái, việc gì xảy ra ở bên phải. *@
        <section class="acct-sec">
            <h2 class="sec-title">Lịch sử hạng</h2>
            <ol class="tier-history">
                @foreach (var change in Model.TierHistory)
                {
                    var up = Array.IndexOf(MembershipService.Order, change.To) > Array.IndexOf(MembershipService.Order, change.From);
                    <li>
                        <span class="th-date">@Fmt.Date(change.At)</span>
                        <span class="th-text">
                            <b class="@(up ? "th-up" : "th-down")">@(up ? "Lên" : "Xuống") hạng @TierStyle.Label(change.To)</b> từ hạng @TierStyle.Label(change.From).
                            <span class="muted">@change.Reason</span>
                        </span>
                    </li>
                }
                <li>
                    <span class="th-date">@Fmt.Date(c.JoinedAt)</span>
                    <span class="th-text">
                        <b>Tham gia chương trình thành viên.</b>
                        <span class="muted">@(Model.TierHistory.Count > 0 ? "Bắt đầu tích luỹ chi tiêu để lên hạng." : $"Bạn đang ở hạng {TierStyle.Label(c.Tier)} từ {Fmt.Date(c.TierSince)}.")</span>
                    </span>
                </li>
            </ol>
        </section>
    </div>
</div>
