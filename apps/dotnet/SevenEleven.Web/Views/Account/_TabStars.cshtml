@using SevenEleven.Core.Models
@using SevenEleven.Core.Services
@using SevenEleven.Web.Infrastructure
@using SevenEleven.Web.Models.Shop
@model AccountModel
@{
    var c = Model.Customer;
    var now = Model.Now;
    var toNext = StarService.SpendToNextStar(c.StarCarry);
    // Thẻ tích dấu cho sao kế tiếp: 9 ô, mỗi ô 5.000 ₫ chi tiêu, đủ 9 dấu là được 1 sao.
    const int slots = 9;
    var perSlot = StarService.StarSpend / slots;
    var stamped = Math.Min(slots, c.StarCarry % StarService.StarSpend / perSlot);
    // Sổ sao: dòng mới nhất ở trên, số dư sau mỗi dòng tính lùi từ số sao hiện có.
    var balance = c.Stars;
}
<div class="acct-secs">
    <section class="star-top">
        <h2 class="star-have">Bạn có <span class="stars">@ShopIcons.Svg("star", 30) @Fmt.Num(c.Stars)</span> sao vàng</h2>
        <div class="stamp-card">
            <ol class="stamp-slots" role="list" aria-label="Đã tích @stamped trên @slots ô cho sao kế tiếp">
                @for (var i = 0; i < slots; i++)
                {
                    <li class="@(i < stamped ? "on" : null)">@if (i < stamped) {@ShopIcons.Svg("star", 18)}</li>
                }
            </ol>
            <p class="stamp-text">Còn <b>@Fmt.Vnd(toNext)</b> nữa là thêm 1 sao. Mỗi ô là @Fmt.Vnd(perSlot) chi tiêu, tính theo tiền thực trả sau giảm giá, không gồm đồ uống có cồn; sao có hạn @StarService.StarValidMonths tháng.</p>
        </div>
    </section>

    <section class="acct-sec">
        <h2 class="sec-title">Đổi sao lấy voucher</h2>
        <p class="sec-sub">Voucher đổi xong nằm trong mục Voucher của tôi, mỗi đơn dùng 1 voucher.</p>
        <partial name="_StarRewards" model="(int?)c.Stars" />
    </section>

    <div class="acct-cols">
        <section class="acct-sec" id="lich-su-sao">
            <h2 class="sec-title">Sổ sao vàng</h2>
            @if (Model.Stars.Count == 0)
            {
                <p class="sec-sub">Chưa có sao nào. Mỗi đơn hàng từ @Fmt.Vnd(StarService.StarSpend) sẽ tích sao vàng.</p>
            }
            else
            {
                <table class="ledger">
                    <caption class="sr-only">Lịch sử sao vàng, mới nhất ở trên</caption>
                    <thead><tr><th scope="col" class="lg-date">Ngày</th><th scope="col">Nội dung</th><th scope="col" class="num">Sao</th><th scope="col" class="num">Còn</th></tr></thead>
                    <tbody>
                        @foreach (var e in Model.Stars)
                        {
                            <tr>
                                <td class="lg-date">@Fmt.Date(e.At)</td>
                                <td class="lg-note"><span class="trunc">@e.Note</span><span class="lg-date-sm">@Fmt.DateTime(e.At)</span></td>
                                <td class="num @(e.Delta > 0 ? "plus" : "minus")">@(e.Delta > 0 ? $"+{e.Delta}" : $"−{-e.Delta}")</td>
                                <td class="num lg-bal">@Fmt.Num(balance)</td>
                            </tr>
                            balance -= e.Delta;
                        }
                    </tbody>
                </table>
                @if (Model.StarTotal > Model.Stars.Count)
                {
                    <div class="ledger-more"><a class="btn btn-ghost btn-sm" href="@ShopUrls.AccountTab("sao-vang")&sao=@(Model.StarLimit + AccountModel.StarPage)" data-keep-scroll-link>Xem thêm</a></div>
                }
            }
        </section>

        <section class="acct-sec">
            <h2 class="sec-title">Voucher của tôi</h2>
            @if (Model.MyVouchers.Count == 0)
            {
                <p class="sec-sub">Chưa có voucher nào. Đổi sao vàng ở phía trên để nhận voucher giảm giá.</p>
            }
            else
            {
                <ul class="my-vouchers">
                    @foreach (var v in Model.MyVouchers)
                    {
                        var used = v.UsageLimit is int limit && v.UsageCount >= limit;
                        var expired = PricingService.EffectiveStatus(v, now) == PromotionStatus.Ended;
                        var usable = !used && !expired;
                        <li class="@(usable ? null : "dim")">
                            <span class="rv-ic">@ShopIcons.Svg("ticket-percent", 20)</span>
                            <div class="min-w-0 flex-1">
                                <p class="mv-title">Giảm @Fmt.Vnd(v.Value) @Tones.Badge(usable ? "fresh" : "neutral", used ? "Đã dùng" : expired ? "Hết hạn" : "Còn hạn")</p>
                                <p class="xs muted">Đơn từ @Fmt.Vnd(v.MinOrderValue ?? 0), hạn dùng @Fmt.Date(v.EndsAt)</p>
                                <button type="button" class="code-chip" data-copy="@v.Code" aria-label="Sao chép mã @v.Code">@v.Code <span class="copy-ic">@ShopIcons.Svg("copy", 14)</span></button>
                            </div>
                            @if (usable)
                            {
                                <form method="post" asp-controller="Account" asp-action="UseVoucher">
                                    <input type="hidden" name="code" value="@v.Code" />
                                    <button class="btn btn-outline btn-sm" type="submit">Dùng ngay</button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
</div>
