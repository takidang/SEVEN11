@using SevenEleven.Web.Infrastructure
@model (string Title, string Description)
@* Lỗi 404 bên trong khung cửa hàng (sản phẩm / danh mục không tồn tại), như not-found-panel.tsx. *@
<div class="nf-panel">
    <span class="empty-ic">@ShopIcons.Svg("search-x", 24)</span>
    <p class="nf-kicker headline">Lỗi 404</p>
    <h1>@Model.Title</h1>
    <p class="nf-desc">@Model.Description</p>
    <div class="nf-actions">
        <a class="btn" href="/">Về trang chủ</a>
        <a class="btn btn-outline" href="@ShopUrls.Promotions">Xem khuyến mãi</a>
    </div>
    <div class="nf-more">
        <p>Có thể bạn đang tìm</p>
        <ul>
            <li><a class="nf-link" href="@ShopUrls.Category("tra-sua")">Trà sữa &amp; Trà trái cây</a></li>
            <li><a class="nf-link" href="@ShopUrls.Category("mon-ngon")">Món ngon nhà Bảy</a></li>
            <li><a class="nf-link" href="@ShopUrls.Category("do-an-vat")">Đồ ăn vặt</a></li>
            <li><a class="nf-link" href="@ShopUrls.Promotions">Flash sale hôm nay</a></li>
        </ul>
    </div>
</div>
