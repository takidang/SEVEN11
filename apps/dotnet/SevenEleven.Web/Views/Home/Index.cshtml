@using SevenEleven.Core.Models
@using SevenEleven.Core.Services
@using SevenEleven.Web.Infrastructure
@using SevenEleven.Web.Models.Shop
@model HomeModel
@{
    var slot = Model.Featured;
    var now = Model.Now;
    var shelf = Model.Shelf;
    var slotCount = slot is null ? 0 : Model.SlotProducts[slot.Promotion.Id].Count;
    // Chữ trên băng đỏ của nhãn giá: bản dài cho nhãn rộng, bản ngắn cho nhãn trên điện thoại.
    var (whenLong, whenShort) = slot switch
    {
        null => ("Giá tốt hôm nay", "hôm nay"),
        { State: SlotState.Live } => ($"Đang giảm đến {Fmt.Time(slot.End)}", $"đến {Fmt.Time(slot.End)}"),
        { NextStart: DateTime next } => ($"Từ {Fmt.Time(next)} {(next.Date == now.Date ? "hôm nay" : "ngày mai")}", $"từ {Fmt.Time(next)}"),
        _ => ("Đã kết thúc", "hết giờ"),
    };
    var cup = """<svg class="ic-cup" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5.5 7.2h13"/><path d="M6.3 7.2 7.6 20a1.3 1.3 0 0 0 1.3 1.1h6.2a1.3 1.3 0 0 0 1.3-1.1l1.3-12.8"/><path d="M6.2 7.2c0-1.5.9-2.4 2.4-2.4h6.8c1.5 0 2.4.9 2.4 2.4"/><path d="M13.6 4.8 15 1.8"/><path d="M7 12.6h10"/></svg>""";
}
<div class="stack-8">
    <h1 class="sr-only">7-Eleven – mở cửa 24 giờ, giao hàng 24 phút</h1>

    <div class="home-top">
        @* Đầu trang là một kệ hàng dưới đèn: món của khung flash sale nổi bật đứng trên kệ, nhãn giá vàng kẹp ở
           mép kệ. Kệ, đèn, nhãn giá là đồ thật của cửa hàng tiện lợi; chuyển động chỉ có ở đây. *@
        <section class="shelf" aria-labelledby="shelf-title">
            <div class="shelf-in">
                <div class="shelf-light" aria-hidden="true"></div>
                <div class="shelf-board" aria-hidden="true"></div>
                <div class="shelf-copy">
                    @if (slot is not null)
                    {
                        <h2 class="shelf-title" id="shelf-title"><span class="ln"><span>@slot.Promotion.Name</span></span><span class="ln ln-sale"><span>giảm @slot.Promotion.Value%</span></span></h2>
                        <p class="shelf-lede">Áp dụng cho @slotCount món, mỗi ngày từ @Fmt.Time(slot.Start) đến @Fmt.Time(slot.End).</p>
                        <div class="shelf-cta">
                            <a class="btn btn-lg shelf-go" href="?khung=@slot.Promotion.Id#flash-sale" data-switch="flash:@slot.Promotion.Id" data-scroll="flash-sale">Xem @slotCount món</a>
                            <a class="btn btn-lg btn-outline" href="@ShopUrls.Promotions">Lịch flash sale</a>
                        </div>
                    }
                    else
                    {
                        <h2 class="shelf-title" id="shelf-title"><span class="ln"><span>Mở cửa 24 giờ,</span></span><span class="ln"><span>giao trong 24 phút</span></span></h2>
                        <p class="shelf-lede">Đồ ăn, thức uống và hàng tiện lợi từ cửa hàng gần bạn nhất.</p>
                        <div class="shelf-cta"><a class="btn btn-lg shelf-go" href="@ShopUrls.Promotions">Xem khuyến mãi</a></div>
                    }
                </div>
                @if (slot is not null)
                {
                    <p class="shelf-sign">
                        @ShopIcons.Svg("clock", 16)
                        <b class="sign-window">@slot.Window</b>
                        @if (slot.State == SlotState.Live)
                        {
                            var left = Fmt.SecondsLeft(slot.End, now);
                            <span class="sign-state" data-left="@left" data-reload>còn <b data-clock>@Fmt.Clock(left)</b></span>
                        }
                        else if (slot.NextStart is DateTime opens && opens.Date == now.Date)
                        {
                            var left = Fmt.SecondsLeft(opens, now);
                            <span class="sign-state" data-left="@left" data-reload>bắt đầu sau <b data-clock>@Fmt.Clock(left)</b></span>
                        }
                        else
                        {
                            <span class="sign-state">@(slot.NextStart is null ? "đã kết thúc" : "ngày mai")</span>
                        }
                    </p>
                }
                <ul class="shelf-goods" role="list">
                    @for (var i = 0; i < shelf.Count; i++)
                    {
                        var item = shelf[i];
                        var p = item.Product;
                        var off = item.Price > item.SalePrice;
                        <li class="good@(item.Facings > 1 ? " good-solo" : null)" style="--i:@i">
                            <a href="@ShopUrls.Product(p.Slug)" title="@p.Name" aria-label="@p.Name, @Fmt.Vnd(item.SalePrice) @whenLong.ToLowerInvariant()@(off ? $", giá thường {Fmt.Vnd(item.Price)}" : null)">
                                <span class="good-row">
                                    @for (var f = 0; f < item.Facings; f++)
                                    {
                                        <span class="good-photo" style="--n:@(i + f)"><img src="@ShopImages.Url(p.Image, 200)" alt="" width="200" height="200" decoding="async" /></span>
                                    }
                                </span>
                                <span class="good-tag">
                                    <span class="good-when">@if (slot is not null) {<span class="when-pct">−@slot.Promotion.Value%</span>}<span class="when-long">@whenLong</span><span class="when-short">@whenShort</span></span>
                                    <span class="good-name">@p.Name</span>
                                    <span class="good-price"><b>@Fmt.Vnd(item.SalePrice)</b>@if (off) {<s>@Fmt.Vnd(item.Price)</s>}</span>
                                </span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </section>
        <a class="member-line" href="@ShopUrls.Membership">
            @Html.Raw(cup)
            <span>Thành viên đủ mốc là lên hạng, voucher đồ uống tới <b>−@Fmt.CompactUpper(MembershipService.Info(MemberTier.Diamond).DrinkVoucher)</b> mỗi ly. <span class="member-more">Xem quyền lợi</span></span>
        </a>
    </div>

    <section>
        <div class="sec-head"><h2>Gợi ý cho bạn</h2></div>
        @* Một dãy kệ nối nhau, mỗi ngăn một nhóm hàng, tên nhóm kẹp ở mép kệ như ở phần đầu trang. *@
        <div class="scroll-row coll-aisle" data-rail>
            <div class="scroll-row-track" data-rail-track>
                <div class="scroll-row-items" role="group" aria-label="Gợi ý cho bạn">
                    @foreach (var (c, tilePhotos) in Model.Collections)
                    {
                        // Món chính đứng giữa, hai món nhỏ hai bên.
                        var row = new[] { (1, "side"), (0, "mid"), (2, "side") }.Where(x => x.Item1 < tilePhotos.Count);
                        <a class="coll@(c.Tall ? " coll-tall" : null)" href="@c.Href">
                            <span class="coll-bay" aria-hidden="true">
                                @foreach (var (at, size) in row)
                                {
                                    // Ảnh có dải chữ ở đáy (ly cà phê "Ngon hơn khi dùng kèm Topping") thì cắt bỏ phần đáy.
                                    var crop = ShopImages.CleanPhotoIds.Contains(tilePhotos[at].Id) ? null : " coll-crop";
                                    <span class="coll-photo coll-@size@(crop)"><img src="@ShopImages.Url(tilePhotos[at].Image, size == "mid" ? 130 : 90)" alt="" loading="lazy" decoding="async" /></span>
                                }
                            </span>
                            <span class="coll-title"><span>@c.Title</span></span>
                        </a>
                    }
                </div>
            </div>
            <button type="button" class="rail-btn rail-prev" data-rail-prev aria-label="Xem trước">@ShopIcons.Svg("chevron-left", 20)</button>
            <button type="button" class="rail-btn rail-next" data-rail-next aria-label="Xem thêm">@ShopIcons.Svg("chevron-right", 20)</button>
        </div>
    </section>

    <section>
        <div class="sec-head"><h2>Danh mục sản phẩm</h2></div>
        <div class="scroll-row cat-strip" data-rail>
            <div class="scroll-row-track" data-rail-track>
                <div class="scroll-row-items" role="group" aria-label="Danh mục sản phẩm">
                    <a class="cat-item" href="@ShopUrls.Promotions">
                        <span class="cat-circle flash">@ShopIcons.Svg("zap", 28, "i-fill")</span>
                        <span class="cat-label">Flash Sale</span>
                    </a>
                    @foreach (var c in Model.Categories)
                    {
                        <a class="cat-item" href="@ShopUrls.Category(c.Slug)">
                            <span class="cat-circle"><img src="@ShopImages.Url(c.Icon, 64)" alt="" loading="lazy" /></span>
                            <span class="cat-label">@c.Name</span>
                        </a>
                    }
                </div>
            </div>
            <button type="button" class="rail-btn rail-prev" data-rail-prev aria-label="Xem trước">@ShopIcons.Svg("chevron-left", 20)</button>
            <button type="button" class="rail-btn rail-next" data-rail-next aria-label="Xem thêm">@ShopIcons.Svg("chevron-right", 20)</button>
        </div>
    </section>

    @if (Model.Slots.Count > 0 && Model.Selected is FlashSlot picked)
    {
        <section id="flash-sale">
            <div class="sec-head">
                <h2><a href="@ShopUrls.Promotions">Flash Sale</a></h2>
                <div class="sec-chips">
                    @foreach (var s in Model.Slots)
                    {
                        var on = s.Promotion.Id == picked.Promotion.Id;
                        <a class="chip @(on ? "active" : null)" href="?khung=@s.Promotion.Id#flash-sale" data-switch="flash:@s.Promotion.Id"
                           aria-pressed="@(on ? "true" : "false")"><span class="chip-time">@Fmt.Time(s.Start)</span>@s.Promotion.Name</a>
                    }
                </div>
                @foreach (var s in Model.Slots)
                {
                    <span class="sec-note" data-panel="flash:@s.Promotion.Id" hidden="@(s.Promotion.Id != picked.Promotion.Id)">
                        @if (s.State == SlotState.Live)
                        {
                            var left = Fmt.SecondsLeft(s.End, now);
                            <span class="cd cd-sm" data-left="@left" data-reload>Kết thúc sau <b data-clock>@Fmt.Clock(left)</b></span>
                        }
                        else
                        {
                            @ShopIcons.Svg("clock", 16, "text-orange")
                            @s.OpensLabel(now)
                        }
                        <span class="pct hide-sm">−@s.Promotion.Value%</span>
                    </span>
                }
                <a class="sec-all" href="@ShopUrls.Promotions">Xem tất cả @ShopIcons.Svg("chevron-right", 16)</a>
            </div>
            @foreach (var s in Model.Slots)
            {
                <div data-panel="flash:@s.Promotion.Id" hidden="@(s.Promotion.Id != picked.Promotion.Id)">
                    <partial name="_ProductRail" model="Model.SlotProducts[s.Promotion.Id]" />
                </div>
            }
        </section>
    }

    @if (Model.NewProducts.Count > 0)
    {
        <section>
            <div class="sec-head"><h2>Sản phẩm mới</h2></div>
            <partial name="_ProductRail" model="Model.NewProducts" />
        </section>
    }

    @foreach (var (category, products) in Model.CategoryRails)
    {
        <section>
            <div class="sec-head">
                <h2><a href="@ShopUrls.Category(category.Slug)">@category.Name</a></h2>
                <div class="sec-chips">
                    @foreach (var sub in category.Subcategories)
                    {
                        <a class="chip" href="@ShopUrls.Category(category.Slug, sub.Slug)">@sub.Name</a>
                    }
                </div>
                <a class="sec-all" href="@ShopUrls.Category(category.Slug)">Xem tất cả @ShopIcons.Svg("chevron-right", 16)</a>
            </div>
            <partial name="_ProductRail" model="products" />
        </section>
    }
</div>
