@using SevenEleven.Web.Areas.Admin.Controllers
@model StocktakeModel
@{
    var store = ViewBag.ScopeStore as Store;
    var here = Context.Request.Path + Context.Request.QueryString;
    var counted = Model.All.Where(r => r.Counted is not null).ToList();
    var matched = counted.Count(r => r.Difference == 0);
    var over = counted.Where(r => r.Difference > 0).ToList();
    var shortRows = counted.Where(r => r.Difference < 0).ToList();
    var catCounted = Model.InCategory.Count(r => r.Counted is not null);
    var pct = Model.InCategory.Count > 0 ? catCounted * 100 / Model.InCategory.Count : 0;
    var catName = Model.Categories.FirstOrDefault(c => c.Id == Model.Category)?.Name;
    string Link(string? view) => "/Admin/Stock/Stocktake?" + string.Join("&", new Dictionary<string, string?> { ["q"] = Model.Query, ["cat"] = Model.Category, ["view"] = view }
        .Where(kv => !string.IsNullOrEmpty(kv.Value)).Select(kv => $"{kv.Key}={Uri.EscapeDataString(kv.Value!)}"));
    var valueDiff = counted.Sum(r => (long)(r.Difference ?? 0) * r.Product.CostPrice);
}
<div class="page-head">
    <div>
        <h1>Kiểm kê · cửa hàng @store?.Code</h1>
        <p>Đã đếm @catCounted/@Model.InCategory.Count mặt hàng · @(catName ?? "tất cả danh mục")</p>
    </div>
    <partial name="_Tabs" model="@("stocktake")" />
</div>
<div class="panel" style="display:grid;gap:10px">
    <div class="meter" style="height:8px"><div style="width:@pct%"></div></div>
    <div class="toolbar">
        @if (counted.Count == 0)
        {
            <span class="muted">Chưa đếm mặt hàng nào. Nhập số lượng thực tế vào cột “Thực tế”.</span>
        }
        else
        {
            <span class="badge fresh">Khớp @matched</span>
            <span class="badge warning">Thừa @over.Count (+@over.Sum(r => r.Difference!.Value))</span>
            <span class="badge danger">Thiếu @shortRows.Count (−@(-shortRows.Sum(r => r.Difference!.Value)))</span>
        }
        <span class="grow"></span>
        <form method="post" asp-action="ResetCounts" class="inline" data-confirm="Làm lại phiên kiểm kho? Xoá @counted.Count số lượng đã đếm. Tồn kho hệ thống không thay đổi.">
            <button class="btn" type="submit" disabled="@(counted.Count == 0)">Làm lại</button>
        </form>
        <form method="post" asp-action="ApplyCounts" class="inline"
              data-confirm="Cân bằng kho cửa hàng @store?.Code? Đã đếm @counted.Count mặt hàng: @matched khớp, @over.Count thừa, @shortRows.Count thiếu. Tồn hệ thống của các mặt hàng lệch sẽ được cập nhật bằng số đếm thực tế (giá trị lệch @Money.Signed(valueDiff)).">
            <button class="btn btn-primary" type="submit" disabled="@(counted.Count == 0)">@(over.Count + shortRows.Count == 0 && counted.Count > 0 ? "Hoàn tất kiểm kho" : "Cân bằng kho") <span class="chip-soft">@counted.Count</span></button>
        </form>
    </div>
</div>
<div class="panel flush">
    <form method="get" class="toolbar" style="padding:16px">
        <select class="input" name="cat" aria-label="Danh mục" onchange="this.form.submit()">
            <option value="">Tất cả danh mục</option>
            @foreach (var c in Model.Categories) { <option value="@c.Id" selected="@(c.Id == Model.Category)">@c.Name</option> }
        </select>
        <label class="search-box">@Icons.Svg("search", 16)<input class="input" name="q" value="@Model.Query" placeholder="Tìm tên, SKU hoặc mã vạch" aria-label="Tìm mặt hàng" /></label>
        <input type="hidden" name="view" value="@Model.View" />
        <button class="btn" type="submit">Lọc</button>
        <nav class="seg">
            <a href="@Link(null)" class="@(Model.View is null ? "active" : null)">Tất cả<span class="n">@Model.InCategory.Count</span></a>
            <a href="@Link("chua-dem")" class="@(Model.View == "chua-dem" ? "active" : null)">Chưa đếm<span class="n">@(Model.InCategory.Count - catCounted)</span></a>
            <a href="@Link("lech")" class="@(Model.View == "lech" ? "active" : null)">Có chênh lệch<span class="n">@Model.InCategory.Count(r => r.Counted is int x && x != r.System)</span></a>
        </nav>
        <span class="grow"></span>
        <span class="result-count">@Model.Shown.Count dòng</span>
    </form>
    @if (Model.Shown.Count == 0)
    {
        <p class="empty"><b>@(Model.View == "lech" ? "Chưa có mặt hàng nào lệch" : Model.View == "chua-dem" ? "Đã đếm hết" : "Không có mặt hàng phù hợp")</b><br />Thử bộ lọc hoặc danh mục khác.</p>
    }
    else
    {
        <form method="post" asp-action="SaveCounts" data-stocktake>
            <input type="hidden" name="returnUrl" value="@here" />
            <div class="table-wrap">
                <table class="table">
                    <thead><tr><th>Sản phẩm</th><th class="num">Tồn hệ thống</th><th class="num">Thực tế</th><th>Chênh lệch</th><th class="num">Giá trị lệch</th></tr></thead>
                    <tbody>
                        @foreach (var r in Model.Shown.Take(300))
                        {
                            <tr>
                                <td><span class="product-cell"><img class="thumb" src="@r.Product.Image" alt="" loading="lazy" /><span>@r.Product.Name<span class="cell-sub">@r.Product.Sku</span></span></span></td>
                                <td class="num">@r.System</td>
                                <td class="num">
                                    <span class="stock-form">
                                        <input class="input input-num" name="counts[@r.Product.Id]" value="@r.Counted" inputmode="numeric" maxlength="5" data-count aria-label="Số đếm thực tế của @r.Product.Name" />
                                        <button type="button" class="btn btn-sm" data-match="@r.System">Khớp</button>
                                    </span>
                                </td>
                                <td>@if (r.Difference is int d) { <span class="badge @(d == 0 ? "fresh" : d > 0 ? "warning" : "danger")">@(d == 0 ? "Khớp" : d > 0 ? $"+{d} thừa" : $"−{-d} thiếu")</span> }</td>
                                <td class="num">@(r.Difference is int d2 && d2 != 0 ? Money.Signed((long)d2 * r.Product.CostPrice) : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="form-actions" style="padding:12px 16px"><button class="btn btn-primary" type="submit">Lưu số đếm</button></div>
        </form>
    }
</div>
