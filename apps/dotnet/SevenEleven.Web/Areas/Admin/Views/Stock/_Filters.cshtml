@model (List<Category> Categories, Dictionary<string, int> Counts, string? Query, string? Category, string? State, int Total)
@{
    string Link(string? state) =>
        "/Admin/Stock?" + string.Join("&", new Dictionary<string, string?> { ["q"] = Model.Query, ["cat"] = Model.Category, ["state"] = state }
            .Where(kv => !string.IsNullOrEmpty(kv.Value)).Select(kv => $"{kv.Key}={Uri.EscapeDataString(kv.Value!)}"));
}
<div style="padding:16px;display:grid;gap:12px">
    <form method="get" class="toolbar">
        <label class="search-box">
            @Icons.Svg("search", 16)
            <input class="input" name="q" value="@Model.Query" placeholder="Tên, mã SKU hoặc mã vạch" aria-label="Tìm mặt hàng" />
        </label>
        <select class="input" name="cat" aria-label="Ngành hàng" onchange="this.form.submit()">
            <option value="">Mọi ngành hàng</option>
            @foreach (var c in Model.Categories)
            {
                <option value="@c.Id" selected="@(c.Id == Model.Category)">@c.Name</option>
            }
        </select>
        @if (Model.State is string st)
        {
            <input type="hidden" name="state" value="@st" />
        }
        <button class="btn" type="submit">Lọc</button>
        <span class="grow"></span>
        <span class="result-count">@Money.FormatNumber(Model.Total) dòng</span>
    </form>
    <nav class="seg" aria-label="Tình trạng tồn">
        <a href="@Link(null)" class="@(Model.State is null ? "active" : null)">Tất cả</a>
        <a href="@Link("out")" class="@(Model.State == "out" ? "active" : null)">Hết hàng<span class="n">@Model.Counts["out"]</span></a>
        <a href="@Link("low")" class="@(Model.State == "low" ? "active" : null)">Sắp hết<span class="n">@Model.Counts["low"]</span></a>
    </nav>
</div>
