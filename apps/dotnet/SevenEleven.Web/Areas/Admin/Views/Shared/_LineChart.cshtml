@model LineChart
<figure class="chart" role="img" aria-label="@Model.Label">
    <div class="chart-plot">
        <div class="chart-grid" aria-hidden="true">
            @foreach (var (value, text) in Model.Ticks)
            {
                <div class="grid-line" style="bottom:@Model.Height(value)%"><span>@text</span></div>
            }
        </div>
        <svg class="chart-lines" viewBox="0 0 @Model.Width 100" preserveAspectRatio="none" aria-hidden="true">
            @foreach (var series in Model.Series.AsEnumerable().Reverse())
            {
                <polyline class="@series.Css" points="@Model.Points(series)" fill="none" vector-effect="non-scaling-stroke" />
            }
        </svg>
        <div class="chart-bars">
            @for (var i = 0; i < Model.Tips.Count; i++)
            {
                <div class="chart-col line-hit @(Model.Highlight == i ? "hl" : null)" tabindex="0" data-tip="@Model.Tips[i]" aria-label="@Model.Tips[i]"></div>
            }
        </div>
    </div>
    <div class="chart-x" aria-hidden="true">
        @for (var i = 0; i < Model.XTicks.Count; i++)
        {
            <span>@(i % Model.LabelEvery == 0 ? Model.XTicks[i] : "")</span>
        }
    </div>
</figure>
