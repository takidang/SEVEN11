@{
    Layout = null;
    bool forced = ViewBag.Forced;
    FormErrors errors = ViewBag.Errors;
    string? returnUrl = ViewBag.ReturnUrl;
    string home = ViewBag.Home;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đổi mật khẩu – Quản lý 7-Eleven</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="icon" href="~/img/logo-mark.png" />
</head>
<body class="admin login-page">
    <main class="login">
        <div class="login-brand">
            <img src="~/img/logo-mark.png" alt="" width="44" height="44" />
            <div><b>7-Eleven</b><small>Khu quản lý cửa hàng</small></div>
        </div>
        <section class="panel">
            <h1>@(forced ? "Đặt mật khẩu mới" : "Đổi mật khẩu")</h1>
            <p class="muted">@ViewBag.Name · @ViewBag.Email</p>
            @if (forced)
            {
                <div class="flash flash-warn" role="status">Mật khẩu hiện tại do người khác cấp. Đặt mật khẩu của riêng bạn để tiếp tục vào khu quản lý.</div>
            }
            <form method="post" asp-area="Admin" asp-controller="Account" asp-action="ChangePassword" class="form" novalidate>
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <label class="field"><span>@(forced ? "Mật khẩu được cấp" : "Mật khẩu hiện tại")</span>
                    <input name="current" type="password" autocomplete="current-password" class="@Forms.Invalid(errors, "Current")" autofocus />
                    @Forms.Error(errors, "Current")
                </label>
                <label class="field"><span>Mật khẩu mới</span>
                    <input name="password" type="password" autocomplete="new-password" maxlength="@PasswordService.MaxLength" class="@Forms.Invalid(errors, "Password")" />
                    @if (errors.Of("Password") is null) { <small class="muted">Tối thiểu @PasswordService.MinLength ký tự, khác mật khẩu hiện tại.</small> }
                    @Forms.Error(errors, "Password")
                </label>
                <label class="field"><span>Nhập lại mật khẩu mới</span>
                    <input name="confirm" type="password" autocomplete="new-password" maxlength="@PasswordService.MaxLength" class="@Forms.Invalid(errors, "Confirm")" />
                    @Forms.Error(errors, "Confirm")
                </label>
                <button class="btn btn-primary btn-block" type="submit">Lưu mật khẩu mới</button>
            </form>
            @if (forced)
            {
                <form method="post" asp-area="Admin" asp-controller="Account" asp-action="Logout">
                    <button class="btn btn-block" type="submit">Đăng xuất</button>
                </form>
            }
            else
            {
                <a class="btn btn-block" href="@(Url.IsLocalUrl(returnUrl) ? returnUrl : home)">Huỷ</a>
            }
        </section>
        <p class="muted" style="text-align:center">Đồ án môn học, không phải hệ thống chính thức của 7-Eleven.</p>
    </main>
</body>
</html>
