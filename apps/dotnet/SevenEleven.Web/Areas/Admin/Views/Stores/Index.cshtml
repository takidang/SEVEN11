@using SevenEleven.Web.Areas.Admin.Controllers
@model StoreListModel
@{
    bool canManage = ViewBag.CanManage;
    var staff = ViewBag.Staff as StaffUser;
    var scopeId = ViewBag.ScopeStoreId as string;
    var all = Model.All;
    var active = all.Count(s => s.Status == StoreStatus.Active);
    var closed = all.Count(s => s.Status == StoreStatus.Closed);
    var maintenance = all.Where(s => s.Status == StoreStatus.Maintenance).ToList();
    var todayRevenue = Model.Metrics.Values.Sum(m => m.Today.Revenue);
    var todayOrders = Model.Metrics.Values.Sum(m => m.Today.Orders);
    var yesterday = Model.Metrics.Values.Sum(m => m.YesterdaySoFar);
    var change = Periods.Change(todayRevenue, yesterday);
    var provinces = all.Select(s => s.Province).Distinct().ToList();
    var filtering = !string.IsNullOrWhiteSpace(Model.Query) || Model.Province is not null || Model.Status is not null;
}
<div class="page-head">
    <div>
        <h1>Cửa hàng</h1>
        <p>@(canManage ? "Mạng lưới cửa hàng, giờ mở cửa, người quản lý và doanh thu từng điểm bán." : "Mạng lưới cửa hàng toàn chuỗi (chỉ xem). Liên hệ quản trị chuỗi để thay đổi thông tin cửa hàng.")</p>
    </div>
    @if (canManage) { <a class="btn btn-primary" asp-action="Edit">@Icons.Svg("plus", 16) Thêm cửa hàng</a> }
</div>
<div class="kpis">
    <div class="kpi"><span class="kpi-label">Tổng cửa hàng</span><b class="kpi-value">@all.Count</b><span class="kpi-sub">@string.Join(" · ", provinces.Select(p => $"{p} {all.Count(s => s.Province == p)}"))</span></div>
    <div class="kpi"><span class="kpi-label">Đang hoạt động</span><b class="kpi-value">@active</b><span class="kpi-sub">@Money.Percent(all.Count > 0 ? active / (double)all.Count : 0) mạng lưới@(closed > 0 ? $" · {closed} đã đóng" : "")</span></div>
    <div class="kpi"><span class="kpi-label">Bảo trì</span><b class="kpi-value">@maintenance.Count</b><span class="kpi-sub">@(maintenance.Count > 0 ? $"Cửa hàng {string.Join(", ", maintenance.Select(s => s.Code))} tạm ngưng bán" : "Không có cửa hàng bảo trì")</span></div>
    <div class="kpi"><span class="kpi-label">Doanh thu hôm nay toàn chuỗi</span><b class="kpi-value">@Money.Format(todayRevenue)</b>
        <span class="kpi-sub">@if (change is double c) { <span class="delta @(c >= 0 ? "up" : "down")">@(c >= 0 ? "▲" : "▼") @Money.Change(c)</span> <span class="delta">so với cùng giờ hôm qua</span> } else { <text>@todayOrders đơn</text> }</span></div>
</div>
<form method="get" class="toolbar">
    <label class="search-box">@Icons.Svg("search", 16)<input class="input" name="q" value="@Model.Query" placeholder="Tìm mã, tên hoặc địa chỉ" aria-label="Tìm cửa hàng" /></label>
    <select class="input" name="province" aria-label="Tỉnh/thành" onchange="this.form.submit()">
        <option value="">Tất cả tỉnh/thành</option>
        @foreach (var p in provinces) { <option value="@p" selected="@(p == Model.Province)">@p</option> }
    </select>
    <select class="input" name="status" aria-label="Trạng thái" onchange="this.form.submit()">
        <option value="">Tất cả trạng thái</option>
        @foreach (var st in Enum.GetValues<StoreStatus>()) { <option value="@st" selected="@(st == Model.Status)">@Labels.Store(st)</option> }
    </select>
    <button class="btn" type="submit">Lọc</button>
    <span class="grow"></span>
    <span class="result-count">@Model.Stores.Count cửa hàng</span>
</form>
@if (Model.Stores.Count == 0)
{
    <div class="panel"><p class="empty">@if (filtering) { <b>Không có cửa hàng phù hợp</b><br /><text>Thử từ khoá, tỉnh/thành hoặc trạng thái khác.</text> } else { <b>Chưa có cửa hàng</b><br /><text>Thêm cửa hàng đầu tiên của chuỗi.</text> }</p></div>
}
<div class="cards">
    @foreach (var s in Model.Stores)
    {
        var m = Model.Metrics.GetValueOrDefault(s.Id) ?? StoreMetrics.Empty(Model.Now);
        var max = Math.Max(1, m.Days.Max(d => d.Revenue));
        var manager = Model.Employees.FirstOrDefault(e => e.Id == s.ManagerId);
        var people = Model.Employees.Count(e => e.StoreId == s.Id && e.Status != EmployeeStatus.Inactive);
        <a class="card" asp-action="Detail" asp-route-id="@s.Id">
            <div class="card-head">
                <b>@s.Code – @s.Name</b>
                <span class="badge @(s.Status == StoreStatus.Active ? "fresh" : s.Status == StoreStatus.Maintenance ? "warning" : "neutral")">@Labels.Store(s.Status)</span>
            </div>
            @if (s.Id == scopeId) { <span class="chip-soft chip-brand">@(staff?.IsAdmin == true ? "Cửa hàng đang chọn" : "Cửa hàng của bạn")</span> }
            <span class="cell-sub">@s.Address, @s.Ward, @s.Province · @s.OpenHours · @Phone.Format(s.Phone)</span>
            <div class="row"><span>Hôm nay</span><span><b>@Money.Format(m.Today.Revenue)</b> · @m.Today.Orders đơn</span></div>
            <div class="row" style="align-items:flex-end"><span>7 ngày <b style="color:var(--fg)">@Money.FormatCompact(m.WeekRevenue)</b></span>
                <span style="display:flex;gap:2px;align-items:flex-end;height:28px">
                    @foreach (var d in m.Days)
                    {
                        <span title="@TimeText.WeekdayShort(d.Day) @d.Day.ToString("dd/MM") · @Money.Format(d.Revenue) · @d.Orders đơn" style="width:8px;background:var(--brand);opacity:.6;border-radius:2px 2px 0 0;height:@(Math.Max(2, d.Revenue * 28 / max))px"></span>
                    }
                </span></div>
            <div class="row"><span>Quản lý</span><span>@(manager?.FullName ?? "Chưa có quản lý")</span></div>
            <div class="row"><span>Nhân viên</span><span>@people nhân viên</span></div>
        </a>
    }
</div>
